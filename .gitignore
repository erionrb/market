# ---- Foundry build artifacts ----
# Regenerated by `forge build`; `out` and `cache` match foundry.toml.
out/
cache/
# Extra profiles sometimes write to their own dirs
out-*/
cache_*/

# Coverage reports
lcov.info
coverage/
*.lcov

# ---- Deployment / broadcast logs ----
# Keep real deployment receipts, drop local + dry-run noise.
broadcast/*/31337/
broadcast/**/dry-run/

# ---- Secrets ----
# Never commit keys or RPC credentials.
.env
.env.*
!.env.example
*.pem
*.key
keystore/

# ---- OS junk ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db

# ---- Editors / IDEs ----
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~

# ---- JS tooling (if added later) ----
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*
